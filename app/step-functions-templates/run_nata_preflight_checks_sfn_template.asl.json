{
  "Comment": "A description of my state machine",
  "StartAt": "Get Deployment Status Manager State",
  "States": {
    "Get Deployment Status Manager State": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": {},
      "Arguments": {
        "FunctionName": "${__get_deployment_status_manager_state_lambda_function_arn__}",
        "Payload": {}
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Assign": {
        "deleted": "{% $states.result.Payload.deleted %}",
        "modified": "{% $states.result.Payload.modified %}",
        "added": "{% $states.result.Payload.added %}",
        "prevTimestamp": "{% $states.result.Payload.prevTimestamp %}",
        "currentTimestamp": "{% $states.result.Payload.currentTimestamp %}"
      },
      "Comment": "Get CloudFormation Status of current workflows and dump this to S3",
      "Next": "For each NATA Approved Workflow"
    },
    "For each NATA Approved Workflow": {
      "Type": "Parallel",
      "End": true,
      "Branches": [
        {
          "StartAt": "Get ctDNA Test Sample Configurations",
          "States": {
            "Get ctDNA Test Sample Configurations": {
              "Type": "Task",
              "Arguments": {
                "Name": "${__tso500_ctdna_test_samples_configuration_ssm_parameter_name__}"
              },
              "Resource": "arn:aws:states:::aws-sdk:ssm:getParameter",
              "Next": "Generate ctDNA Draft Events",
              "Output": {
                "sampleConfigurationsList": "{% $states.result.Parameter.Value ~> $parse %}"
              }
            },
            "Generate ctDNA Draft Events": {
              "Type": "Map",
              "ItemProcessor": {
                "ProcessorConfig": {
                  "Mode": "INLINE"
                },
                "StartAt": "Generate Dragen TSO500 ctDNA Validation Analyses Draft Events",
                "States": {
                  "Generate Dragen TSO500 ctDNA Validation Analyses Draft Events": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Output": {
                      "eventDetail": "{% $states.result.Payload.eventDetail %}"
                    },
                    "Assign": {
                      "portalRunId": "{% $states.result.Payload.eventDetail.portalRunId %}"
                    },
                    "Arguments": {
                      "FunctionName": "${__generate_ctdna_validation_event_lambda_function_arn__}",
                      "Payload": {
                        "sampleConfiguration": "{% $states.input %}"
                      }
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 1,
                        "MaxAttempts": 3,
                        "BackoffRate": 2,
                        "JitterStrategy": "FULL"
                      }
                    ],
                    "Next": "Put Dragen TSO500 ctDNA Validation WRU DRAFT Event"
                  },
                  "Put Dragen TSO500 ctDNA Validation WRU DRAFT Event": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::events:putEvents",
                    "Arguments": {
                      "Entries": [
                        {
                          "Detail": "{% $states.input.eventDetail %}",
                          "DetailType": "${__workflow_run_update_detail_type__}",
                          "EventBusName": "${__event_bus_name__}",
                          "Source": "${__stack_source__}"
                        }
                      ]
                    },
                    "Next": "Wait 1 Minute (ctDNA)"
                  },
                  "Wait 1 Minute (ctDNA)": {
                    "Type": "Wait",
                    "Seconds": 60,
                    "Next": "Summarise deploy status manager changes as comments on workflow (ctDNA)"
                  },
                  "Summarise deploy status manager changes as comments on workflow (ctDNA)": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Arguments": {
                      "Payload": {
                        "deleted": "{% $deleted %}",
                        "modified": "{% $modified %}",
                        "added": "{% $added %}",
                        "prevTimestamp": "{% $prevTimestamp %}",
                        "currentTimestamp": "{% $currentTimestamp %}",
                        "portalRunId": "{% $portalRunId %}"
                      },
                      "FunctionName": "${__summarise_deploy_status_manager_changes_lambda_function_arn__}"
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 1,
                        "MaxAttempts": 3,
                        "BackoffRate": 2,
                        "JitterStrategy": "FULL"
                      }
                    ],
                    "End": true,
                    "Output": {}
                  }
                }
              },
              "End": true,
              "Items": "{% $states.input.sampleConfigurationsList %}"
            }
          }
